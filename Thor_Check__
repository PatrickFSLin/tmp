trajectory = np.asarray(trajectory, dtype=np.float32)

# Remove only leading singleton dimensions.
while trajectory.ndim > 2 and trajectory.shape[0] == 1:
    trajectory = trajectory[0]

if trajectory.shape != (6, 2):
    raise RuntimeError(
        f"Unexpected normalized trajectory shape at "
        f"sample {sample_index}, traj {traj_idx}: "
        f"{trajectory.shape}"
    )

trajectories.append(trajectory)
